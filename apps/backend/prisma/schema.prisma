generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Car {
  id           Int       @id  @default(autoincrement())
  brand        String
  model        String
  year         Int
  color        String?
  pricePerDay  Decimal
  isAvailable  Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
